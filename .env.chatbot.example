# Chatbot configuration — copy to .env (or export) before docker-compose up.
# All values are optional except STOCKS_API_URL when running outside Docker.

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# auto    = try Mistral → Groq → local (default)
# mistral = always Mistral (free tier)
# groq    = always Groq (free tier)
# local   = always local llama.cpp (no internet needed)
LLM_PROVIDER=auto

# Get a free key at https://console.mistral.ai/
MISTRAL_API_KEY=

# Get a free key at https://console.groq.com/
GROQ_API_KEY=

# Optional: override default models
# MISTRAL_MODEL=mistral-small-latest
# GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# Local LLM (always available as fallback)
# ---------------------------------------------------------------------------
# The default model is auto-downloaded on first ai-service startup (~1 GB).
# Tweak threads to match your VPS — leave one core free for everything else.
LOCAL_LLM_THREADS=3
LOCAL_LLM_CTX=4096
LOCAL_LLM_AUTO_DOWNLOAD=true

# ---------------------------------------------------------------------------
# RAG configuration
# ---------------------------------------------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_INDEX_ON_STARTUP=true
# Colon-separated paths; can be files or directories (recursive *.md).
RAG_CORPUS_PATHS=/app/corpus

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
CHAT_DEFAULT_LANG=fr
CHAT_MAX_TOOL_ITERATIONS=3
CHAT_RAG_TOP_K=5

# ---------------------------------------------------------------------------
# Reporting — automatic PDF reports via SendGrid
# ---------------------------------------------------------------------------
# Set REPORTS_ENABLED=false to disable the report scheduler entirely.
REPORTS_ENABLED=true

# SendGrid API key — get one free at https://sendgrid.com (100 emails/day free tier).
SENDGRID_API_KEY=

# Sender address (must be verified in your SendGrid account).
REPORT_FROM_EMAIL=reports@stock-s.fr
REPORT_FROM_NAME=Stock Platform Reports

# Platform admin email — receives the platform-wide summary report.
PLATFORM_ADMIN_EMAIL=

# Cron schedules (standard 5-field cron syntax, UTC).
# Defaults: daily at 23:00, weekly Mon 08:00, monthly 1st at 09:00.
# REPORT_DAILY_CRON=0 23 * * *
# REPORT_WEEKLY_CRON=0 8 * * 1
# REPORT_MONTHLY_CRON=0 9 1 * *
