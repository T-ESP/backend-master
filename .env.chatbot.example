# Chatbot configuration — copy to .env (or export) before docker-compose up.
# All values are optional except STOCKS_API_URL when running outside Docker.

# ---------------------------------------------------------------------------
# LLM provider selection
# ---------------------------------------------------------------------------
# auto    = try Groq → Mistral (default)
# groq    = always Groq (primary)
# mistral = always Mistral (fallback)
LLM_PROVIDER=groq

# Required: get a free key at https://console.groq.com/
GROQ_API_KEY=

# Optional (auto-fallback if Groq 429s): https://console.mistral.ai/
MISTRAL_API_KEY=

# Optional: override default models
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-small-latest

# ---------------------------------------------------------------------------
# RAG configuration
# ---------------------------------------------------------------------------
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_INDEX_ON_STARTUP=true
# Colon-separated paths; can be files or directories (recursive *.md).
RAG_CORPUS_PATHS=/app/corpus

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
CHAT_DEFAULT_LANG=fr
CHAT_MAX_TOOL_ITERATIONS=3
CHAT_RAG_TOP_K=5
