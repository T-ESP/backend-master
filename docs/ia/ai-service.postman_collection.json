{
  "info": {
    "name": "ai-service",
    "description": "AI Service & Alert Management endpoints for the Stock Management Platform.\n\nHow to use:\n1. Run the \"Login\" request first — it auto-saves the JWT token.\n2. All other requests use that token automatically.\n3. Change {{base_url}} or {{ai_url}} in collection variables if your ports differ.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8090",
      "type": "string"
    },
    {
      "key": "ai_url",
      "value": "http://localhost:8001",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "product_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "supplier_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "alert_id",
      "value": "1",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data && res.data.token) {",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Token saved successfully');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"adminpass\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Login and auto-save the JWT token. Run this first."
          },
          "response": []
        }
      ]
    },
    {
      "name": "AI Service (direct)",
      "description": "Endpoints on the Python AI service (port 8001). No auth required.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{ai_url}}/ai/health",
              "host": ["{{ai_url}}"],
              "path": ["ai", "health"]
            },
            "description": "Check if the AI service and database connection are healthy."
          },
          "response": []
        },
        {
          "name": "Last Run Status",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": {
              "raw": "{{ai_url}}/ai/status",
              "host": ["{{ai_url}}"],
              "path": ["ai", "status"]
            },
            "description": "Get metrics from the last AI model run: duration, success/failure counts, errors per handler."
          },
          "response": []
        },
        {
          "name": "Trigger Models Manually",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": {
              "raw": "{{ai_url}}/ai/run",
              "host": ["{{ai_url}}"],
              "path": ["ai", "run"]
            },
            "description": "Trigger all 7 AI models to run immediately. Returns 409 if a run is already in progress."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Demand Forecasts",
      "item": [
        {
          "name": "List Forecasts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/forecasts?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["ai", "forecasts"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Get latest demand forecasts for all products. Includes predicted demand, stock recommendations, and urgency."
          },
          "response": []
        },
        {
          "name": "Forecast by Product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/forecasts/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai", "forecasts", "{{product_id}}"]
            },
            "description": "Get demand forecast for a specific product."
          },
          "response": []
        },
        {
          "name": "Urgent Restocks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/urgent-restocks?limit=50",
              "host": ["{{base_url}}"],
              "path": ["ai", "urgent-restocks"],
              "query": [
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Products that need restocking urgently based on demand forecasts. Filtered to URGENT and HIGH urgency only."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Classifications (ABC-XYZ)",
      "item": [
        {
          "name": "List Classifications",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/classifications?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["ai", "classifications"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Get ABC-XYZ classifications for all products. A/B/C = revenue importance, X/Y/Z = demand predictability."
          },
          "response": []
        },
        {
          "name": "Classification by Product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/classifications/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai", "classifications", "{{product_id}}"]
            },
            "description": "Get ABC-XYZ classification for a specific product."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Product Clusters",
      "item": [
        {
          "name": "List Clusters",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/clusters?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["ai", "clusters"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Get K-Means cluster assignments for all products. Products in the same cluster share similar sales patterns."
          },
          "response": []
        },
        {
          "name": "Cluster by Product",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/clusters/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai", "clusters", "{{product_id}}"]
            },
            "description": "Get cluster assignment for a specific product."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Supplier Scores",
      "item": [
        {
          "name": "List Supplier Scores",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/supplier-scores?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["ai", "supplier-scores"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "offset", "value": "0" }
              ]
            },
            "description": "Get performance scores for all suppliers. Rated EXCELLENT to UNACCEPTABLE based on delivery, quality, lead time, and fulfillment."
          },
          "response": []
        },
        {
          "name": "Score by Supplier",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/supplier-scores/{{supplier_id}}",
              "host": ["{{base_url}}"],
              "path": ["ai", "supplier-scores", "{{supplier_id}}"]
            },
            "description": "Get performance score for a specific supplier."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Price Suggestions",
      "item": [
        {
          "name": "List Price Suggestions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/price-suggestions?limit=50",
              "host": ["{{base_url}}"],
              "path": ["ai", "price-suggestions"],
              "query": [
                { "key": "limit", "value": "50" }
              ]
            },
            "description": "Get AI-suggested optimal prices. Includes suggested price, confidence score, and reasoning."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Price Anomalies",
      "item": [
        {
          "name": "List All Price Records",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/price-anomalies?limit=50&only_anomalies=false",
              "host": ["{{base_url}}"],
              "path": ["ai", "price-anomalies"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "only_anomalies", "value": "false" }
              ]
            },
            "description": "Get all price anomaly analysis results (including non-anomalous)."
          },
          "response": []
        },
        {
          "name": "List Anomalies Only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/price-anomalies?limit=50&only_anomalies=true",
              "host": ["{{base_url}}"],
              "path": ["ai", "price-anomalies"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "only_anomalies", "value": "true" }
              ]
            },
            "description": "Get only flagged price anomalies (is_anomaly=true). These are prices that deviate significantly from expected."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Sales Anomalies",
      "item": [
        {
          "name": "List All Sales Records",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/sales-anomalies?limit=50&only_anomalies=false",
              "host": ["{{base_url}}"],
              "path": ["ai", "sales-anomalies"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "only_anomalies", "value": "false" }
              ]
            },
            "description": "Get all sales anomaly analysis results (including non-anomalous)."
          },
          "response": []
        },
        {
          "name": "List Anomalies Only",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/ai/sales-anomalies?limit=50&only_anomalies=true",
              "host": ["{{base_url}}"],
              "path": ["ai", "sales-anomalies"],
              "query": [
                { "key": "limit", "value": "50" },
                { "key": "only_anomalies", "value": "true" }
              ]
            },
            "description": "Get only flagged sales anomalies (is_anomaly=true). Unusually high or low sales volumes."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Alerts",
      "description": "Alert lifecycle management. AI models generate alerts automatically; these endpoints let you view, filter, and manage them.",
      "item": [
        {
          "name": "List Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/alerts?limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["alerts"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "offset", "value": "0" },
                { "key": "status", "value": "new", "disabled": true },
                { "key": "severity", "value": "critical", "disabled": true },
                { "key": "model_type", "value": "price_anomaly", "disabled": true },
                { "key": "product_id", "value": "1", "disabled": true },
                { "key": "category", "value": "alert", "disabled": true },
                { "key": "from_date", "value": "2024-01-01", "disabled": true },
                { "key": "to_date", "value": "2026-12-31", "disabled": true }
              ]
            },
            "description": "List alerts with optional filters. Enable/disable query params as needed.\n\nFilter options:\n- status: new, acknowledged, in_progress, resolved, dismissed\n- severity: critical, high, medium, low\n- model_type: demand_forecast, classification, price_anomaly, sales_anomaly, supplier_scoring, price_suggestion\n- category: alert, suggestion"
          },
          "response": []
        },
        {
          "name": "List Critical Alerts",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/alerts?severity=critical&status=new&limit=20",
              "host": ["{{base_url}}"],
              "path": ["alerts"],
              "query": [
                { "key": "severity", "value": "critical" },
                { "key": "status", "value": "new" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Shortcut: get only new critical alerts."
          },
          "response": []
        },
        {
          "name": "Alert Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/alerts/summary",
              "host": ["{{base_url}}"],
              "path": ["alerts", "summary"]
            },
            "description": "Dashboard widget: total alerts, counts by status, severity, and model type."
          },
          "response": []
        },
        {
          "name": "Get Alert by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/alerts/{{alert_id}}",
              "host": ["{{base_url}}"],
              "path": ["alerts", "{{alert_id}}"]
            },
            "description": "Get a single alert by its ID."
          },
          "response": []
        },
        {
          "name": "Update Alert Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"acknowledged\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/alerts/{{alert_id}}/status",
              "host": ["{{base_url}}"],
              "path": ["alerts", "{{alert_id}}", "status"]
            },
            "description": "Update a single alert's status.\n\nValid values: new, acknowledged, in_progress, resolved, dismissed"
          },
          "response": []
        },
        {
          "name": "Bulk Update Status",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ids\": [1, 2, 3, 4, 5],\n  \"status\": \"acknowledged\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/alerts/bulk-status",
              "host": ["{{base_url}}"],
              "path": ["alerts", "bulk-status"]
            },
            "description": "Update multiple alerts at once. Pass an array of IDs and the target status."
          },
          "response": []
        },
        {
          "name": "Cleanup Old Alerts",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/alerts/cleanup?older_than_days=30",
              "host": ["{{base_url}}"],
              "path": ["alerts", "cleanup"],
              "query": [
                { "key": "older_than_days", "value": "30" }
              ]
            },
            "description": "Delete resolved/dismissed alerts older than N days. Default: 30 days."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Product KPIs (AI-enriched)",
      "description": "Product-level KPIs that include AI data alongside traditional calculations.",
      "item": [
        {
          "name": "Predictions & Alerts KPI",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/kpis/predictions-alerts",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "kpis", "predictions-alerts"]
            },
            "description": "Stockout predictions and restock recommendations. Fields prefixed with ai_ come from the demand forecaster. If ai_forecast_available is false, ai_ fields are null."
          },
          "response": []
        },
        {
          "name": "Scoring & Classification KPI",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products/{{product_id}}/kpis/scoring-classification",
              "host": ["{{base_url}}"],
              "path": ["products", "{{product_id}}", "kpis", "scoring-classification"]
            },
            "description": "Product scoring and classification. Includes AI-powered ABC-XYZ class and cluster assignment alongside traditional computed scores. If ai_classification_available is false, ai_ fields are null."
          },
          "response": []
        }
      ]
    }
  ]
}
